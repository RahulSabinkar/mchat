{
  "item_number": 5,
  "question": "5. Does _________ make unusual finger movements near his/her eyes?",
  "flow": {
    "start": {
      "type": "initial_question",
      "options": [
        { "label": "Yes", "next": "ask_yes_followup" },
        { "label": "No", "actions": [{ "type": "set_score", "value": 0 }], "next": "completed" }
      ]
    },
    "ask_yes_followup": {
      "type": "instruction",
      "text": "Please describe these movements (If parent does not give a 0 example below, ask each individually.)",
      "next": "evaluate_behaviors"
    },
    "evaluate_behaviors": {
      "type": "checklist",
      "instruction": "Does he/she...",
      "categories": [
        {
          "id": "pass_examples",
          "instruction": "Does he/she ...\n(Below are pass examples)",
          "items": [
            { "text": "Look at hands?" },
            { "text": "Move fingers when playing peek-a-boo?" }
          ]
        },
        {
          "id": "risk_examples",
          "instruction": "Does he/she...\n(Below are risk examples)",
          "items": [
            { "text": "Wiggle his/her fingers near his/her eyes?" },
            { "text": "Hold his/her hands up close to his/her eyes?" },
            { "text": "Hold his/her hands off to the side of his/her eyes?" },
            { "text": "Flap his/her hands near his/her face?" },
            { "text": "Other (describe) ________________________________________________" }
          ]
        }
      ],
      "options": [
        { "label": "Yes" },
        { "label": "No" }
      ],
      "next": "determine_score"
    },
    "determine_score": {
      "type": "transient_logic",
      "conditions": [
        {
          "type": "category_selection",
          "expression": "only_pass_selected",
          "actions": [{ "type": "set_score", "value": 0 }],
          "next": "completed"
        },
        {
          "type": "selection_count",
          "expression": "none_selected",
          "actions": [{ "type": "set_score", "value": 0 }],
          "next": "completed"
        },
        {
          "type": "category_selection",
          "expression": "only_risk_selected",
          "actions": [],
          "next": "check_frequency"
        },
        {
          "type": "category_selection",
          "expression": "both_selected",
          "actions": [],
          "next": "check_frequency"
        }
      ]
    },
    "check_frequency": {
      "type": "followup_question",
      "text": "Does this happen more than twice a week?",
      "options": [
        { "label": "No", "actions": [{ "type": "set_score", "value": 0 }], "next": "completed" },
        { "label": "Yes", "actions": [{ "type": "set_score", "value": 1 }], "next": "completed" }
      ]
    }
  },
  "metadata": {
    "copyright": "©2009 Diana Robins, Deborah Fein, & Marianne Barton",
    "version": "Terminology Update March 2025"
  }
}
