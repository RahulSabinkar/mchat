{
  "item_number": 8,
  "question": "8. Is ____________ interested in other children?",
  "flow": {
    "start": {
      "type": "initial_question",
      "options": [
        { "label": "Yes", "next": "ask_brother_sister" },
        { "label": "No", "next": "ask_supermarket" }
      ]
    },
    "ask_brother_sister": {
      "type": "followup_question",
      "text": "Is he/she interested in children who are not his/her brother or sister?",
      "options": [
        { "label": "Yes", "actions": [{ "type": "set_score", "value": 0 }], "next": "completed" },
        { "label": "No", "next": "how_does_child_respond" }
      ]
    },
    "ask_supermarket": {
      "type": "followup_question",
      "text": "When you are at the playground or supermarket, does your child usually respond to other children?",
      "options": [
        { "label": "Yes", "next": "how_does_child_respond" },
        { "label": "No", "actions": [{ "type": "set_score", "value": 1 }], "next": "completed" }
      ]
    },
    "how_does_child_respond": {
      "type": "instruction",
      "text": "How does your child respond? (If parent does not give a 0 example below, ask each individually.)",
      "next": "evaluate_behaviors"
    },
    "evaluate_behaviors": {
      "type": "checklist",
      "instruction": "Does your child...",
      "items": [
        { "text": "Play with another child?" },
        { "text": "Talk to another child?" },
        { "text": "Babble or make vocal noises?" },
        { "text": "Watch another child?" },
        { "text": "Smile at another child?" },
        { "text": "Act shy at first but then smile?" },
        { "text": "Get excited about another child?" }
      ],
      "options": [
        { "label": "Yes" },
        { "label": "No" }
      ],
      "next": "determine_score"
    },
    "determine_score": {
      "type": "transient_logic",
      "conditions": [
        {
          "type": "selection_count",
          "expression": "any_selected",
          "actions": [],
          "next": "check_frequency"
        },
        {
          "type": "selection_count",
          "expression": "none_selected",
          "actions": [{ "type": "set_score", "value": 1 }],
          "next": "completed"
        }
      ]
    },
    "check_frequency": {
      "type": "followup_question",
      "text": "Does he/she respond to other children more than half of the time?",
      "options": [
        { "label": "Yes", "actions": [{ "type": "set_score", "value": 0 }], "next": "completed" },
        { "label": "No", "actions": [{ "type": "set_score", "value": 1 }], "next": "completed" }
      ]
    }
  },
  "metadata": {
    "copyright": "©2009 Diana Robins, Deborah Fein, & Marianne Barton",
    "version": "Terminology Update March 2025"
  }
}
