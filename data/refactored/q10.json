{
  "item_number": 10,
  "question": "10. Does ____________ respond when you call his/her name?",
  "flow": {
    "start": {
      "type": "initial_question",
      "options": [
        { "label": "Yes", "next": "ask_yes_followup" },
        { "label": "No", "next": "ask_no_followup" }
      ]
    },
    "ask_yes_followup": {
      "type": "instruction",
      "text": "Please give me an example of how he/she responds when you call his/her name. (If parent does not give a 0 example below, ask each individually.)",
      "next": "evaluate_behaviors"
    },
    "ask_no_followup": {
      "type": "instruction",
      "text": "If he/she is not involved in something fun or interesting, what does he/she do when you call his/her name? (If parent does not give a 0 example below, ask each individually.)",
      "next": "evaluate_behaviors"
    },
    "evaluate_behaviors": {
      "type": "checklist",
      "instruction": "Does he/she...",
      "categories": [
        {
          "id": "pass_examples",
          "instruction": "Does he/she...\n(below are pass examples)",
          "items": [
            { "text": "Look up?" },
            { "text": "Talk or babble?" },
            { "text": "Stop what he/she is doing?" }
          ]
        },
        {
          "id": "risk_examples",
          "instruction": "Does he/she...\n(below are risk examples)",
          "items": [
            { "text": "Make no response?" },
            { "text": "Seem to hear but ignores parent?" },
            { "text": "Respond only if parent is right in front of the child's face?" },
            { "text": "Respond only if touched?" }
          ]
        }
      ],
      "options": [
        { "label": "Yes" },
        { "label": "No" }
      ],
      "next": "determine_score"
    },
    "determine_score": {
      "type": "transient_logic",
      "conditions": [
        {
          "type": "category_selection",
          "expression": "only_pass_selected",
          "actions": [{ "type": "set_score", "value": 0 }],
          "next": "completed"
        },
        {
          "type": "category_selection",
          "expression": "only_risk_selected",
          "actions": [{ "type": "set_score", "value": 1 }],
          "next": "completed"
        },
        {
          "type": "category_selection",
          "expression": "both_selected",
          "actions": [],
          "next": "clarify_frequency"
        }
      ]
    },
    "clarify_frequency": {
      "type": "followup_question",
      "text": "Which one does he/she do most often?",
      "options": [
        { "label": "Pass response", "actions": [{ "type": "set_score", "value": 0 }], "next": "completed" },
        { "label": "Risk response", "actions": [{ "type": "set_score", "value": 1 }], "next": "completed" }
      ]
    }
  },
  "metadata": {
    "copyright": "©2009 Diana Robins, Deborah Fein, & Marianne Barton",
    "version": "Terminology Update March 2025"
  }
}
