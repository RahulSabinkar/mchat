{
  "item_number": 6,
  "question": "6. Does ____________ point with one finger to ask for something or to get help?",
  "flow": {
    "start": {
      "type": "initial_question",
      "options": [
        { "label": "Yes", "actions": [{ "type": "set_score", "value": 0 }], "next": "completed" },
        { "label": "No", "next": "ask_no_followup" }
      ]
    },
    "ask_no_followup": {
      "type": "instruction",
      "text": "If there is something your child wants that is out of reach, such as a snack or toy that is out of reach, how does he/she get it? (If parent does not give a 0 example below, ask each individually.)",
      "next": "evaluate_behaviors"
    },
    "evaluate_behaviors": {
      "type": "checklist",
      "instruction": "Does he/she...",
      "items": [
        { "text": "Reach for the object with his/her whole hand?" },
        { "text": "Lead you to the object?" },
        { "text": "Try to get the object for him/herself?" },
        { "text": "Ask for it using words or sounds?" }
      ],
      "options": [
        { "label": "Yes" },
        { "label": "No" }
      ],
      "next": "determine_score"
    },
    "determine_score": {
      "type": "transient_logic",
      "conditions": [
        {
          "type": "selection_count",
          "expression": "any_selected",
          "actions": [],
          "next": "show_me_prompt"
        },
        {
          "type": "selection_count",
          "expression": "none_selected",
          "actions": [{ "type": "set_score", "value": 1 }],
          "next": "completed"
        }
      ]
    },
    "show_me_prompt": {
      "type": "followup_question",
      "text": "If you said \"Show me,\" would he/she point at it?",
      "options": [
        { "label": "Yes", "actions": [{ "type": "set_score", "value": 0 }], "next": "completed" },
        { "label": "No", "actions": [{ "type": "set_score", "value": 1 }], "next": "completed" }
      ]
    }
  },
  "metadata": {
    "copyright": "©2009 Diana Robins, Deborah Fein, & Marianne Barton",
    "version": "Terminology Update March 2025"
  }
}
