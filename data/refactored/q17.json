{
  "item_number": 17,
  "question": "17. Does ____________ try to get you to watch him/her?",
  "flow": {
    "start": {
      "type": "initial_question",
      "options": [
        { "label": "Yes", "next": "ask_yes_example" },
        { "label": "No", "next": "evaluate_behaviors" }
      ]
    },
    "ask_yes_example": {
      "type": "instruction",
      "text": "Please give me an example of how he/she would try to get you to watch him/her. (If parent does not give a 0 example below, ask each individually.)",
      "next": "evaluate_behaviors"
    },
    "evaluate_behaviors": {
      "type": "checklist",
      "instruction": "Does he/she...",
      "items": [
        { "text": "Say \"Look!\" or \"Watch me!\"?" },
        { "text": "Babble or make a noise to get you to watch what he/ she is doing?" },
        { "text": "Look at you to get praise or comment?" },
        { "text": "Keep looking to see if you are looking?" },
        { "text": "Other (describe): ________________________________________________" }
      ],
      "options": [
        { "label": "Yes" },
        { "label": "No" }
      ],
      "next": "determine_score"
    },
    "determine_score": {
      "type": "transient_logic",
      "conditions": [
        {
          "type": "selection_count",
          "expression": "any_selected",
          "actions": [{ "type": "set_score", "value": 0 }],
          "next": "completed"
        },
        {
          "type": "selection_count",
          "expression": "none_selected",
          "actions": [{ "type": "set_score", "value": 1 }],
          "next": "completed"
        }
      ]
    }
  },
