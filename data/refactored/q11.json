{
  "item_number": 11,
  "question": "11. When you smile at ____________, does he/she smile back at you?",
  "flow": {
    "start": {
      "type": "initial_question",
      "options": [
        { "label": "Yes", "actions": [{ "type": "set_score", "value": 0 }], "next": "completed" },
        { "label": "No", "next": "ask_no_followup" }
      ]
    },
    "ask_no_followup": {
      "type": "instruction",
      "text": "What makes ____________ smile? (If parent does not give a 0 example below, ask each individually.)",
      "next": "evaluate_behaviors"
    },
    "evaluate_behaviors": {
      "type": "checklist",
      "instruction": "Does your child...",
      "categories": [
        {
          "id": "pass_examples",
          "instruction": "Does your child...\n(Below are pass examples)",
          "items": [
            { "text": "Smile when you smile?" },
            { "text": "Smile when you enter the room?" },
            { "text": "Smile when you return from being away?" }
          ]
        },
        {
          "id": "risk_examples",
          "instruction": "Does he/she ...\n(Below are risk examples)",
          "items": [
            { "text": "Always smile?" },
            { "text": "Smile at a favorite toy or activity?" },
            { "text": "Smile randomly or at nothing in particular?" }
          ]
        }
      ],
      "options": [
        { "label": "Yes" },
        { "label": "No" }
      ],
      "next": "determine_score"
    },
    "determine_score": {
      "type": "transient_logic",
      "conditions": [
        {
          "type": "category_selection",
          "expression": "only_pass_selected",
          "actions": [{ "type": "set_score", "value": 0 }],
          "next": "completed"
        },
        {
          "type": "category_selection",
          "expression": "only_risk_selected",
          "actions": [{ "type": "set_score", "value": 1 }],
          "next": "completed"
        },
        {
          "type": "category_selection",
          "expression": "both_selected",
          "actions": [],
          "next": "clarify_frequency"
        }
      ]
    },
    "clarify_frequency": {
      "type": "followup_question",
      "text": "Which one does he/she do most often?",
      "options": [
        { "label": "Pass response", "actions": [{ "type": "set_score", "value": 0 }], "next": "completed" },
        { "label": "Risk response", "actions": [{ "type": "set_score", "value": 1 }], "next": "completed" }
      ]
    }
  },
  "metadata": {
    "copyright": "©2009 Diana Robins, Deborah Fein, & Marianne Barton",
    "version": "Terminology Update March 2025"
  }
}
