{
  "item_number": 16,
  "question": "16. If you turn your head to look at something, does ____________ look around to see what you are looking at?",
  "flow": {
    "start": {
      "type": "initial_question",
      "options": [
        { "label": "Yes", "actions": [{ "type": "set_score", "value": 0 }], "next": "completed" },
        { "label": "No", "next": "ask_no_followup" }
      ]
    },
    "ask_no_followup": {
      "type": "instruction",
      "text": "What does he/she do when you turn to look at something? (If parent does not give a 0 example below, ask each individually.)",
      "next": "evaluate_behaviors"
    },
    "evaluate_behaviors": {
      "type": "checklist",
      "instruction": "Does your child...",
      "categories": [
        {
          "id": "pass_examples",
          "instruction": "Does your child...\n(Below are pass examples)",
          "items": [
            { "text": "Look toward the thing you are looking at?" },
            { "text": "Point toward the thing you are looking at?" },
            { "text": "Look around to see what you are looking at?" }
          ]
        },
        {
          "id": "risk_examples",
          "instruction": "Does you child...\n(Below are risk examples)",
          "items": [
            { "text": "Ignore you?" },
            { "text": "Look at your face?" }
          ]
        }
      ],
      "options": [
        { "label": "Yes" },
        { "label": "No" }
      ],
      "next": "determine_score"
    },
    "determine_score": {
      "type": "transient_logic",
      "conditions": [
        {
          "type": "category_selection",
          "expression": "only_pass_selected",
          "actions": [{ "type": "set_score", "value": 0 }],
          "next": "completed"
        },
        {
          "type": "category_selection",
          "expression": "only_risk_selected",
          "actions": [{ "type": "set_score", "value": 1 }],
          "next": "completed"
        },
        {
          "type": "category_selection",
          "expression": "both_selected",
          "actions": [],
          "next": "clarify_frequency"
        }
      ]
    },
    "clarify_frequency": {
      "type": "followup_question",
      "text": "Which one does he/she do most often?",
      "options": [
        { "label": "Pass response", "actions": [{ "type": "set_score", "value": 0 }], "next": "completed" },
        { "label": "Risk response", "actions": [{ "type": "set_score", "value": 1 }], "next": "completed" }
      ]
    }
  },
  "metadata": {
