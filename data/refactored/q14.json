{
  "item_number": 14,
  "question": "14. Does ____________ look you in the eye when you are talking to him/her, playing with him/her, or changing him/her?",
  "flow": {
    "start": {
      "type": "initial_question",
      "options": [
        { "label": "Yes", "next": "ask_yes_followup" },
        { "label": "No", "next": "evaluate_behaviors" }
      ]
    },
    "ask_yes_followup": {
      "type": "instruction",
      "text": "Please give me an example of when he/she looks you in the eye. (If parent does not give one of the following 0 examples, ask each individually.)",
      "next": "evaluate_behaviors"
    },
    "evaluate_behaviors": {
      "type": "checklist",
      "instruction": "Does he/she look you in the eye...",
      "items": [
        { "text": "When he/she needs something?" },
        { "text": "When you are playing with him/her?" },
        { "text": "During feeding?" },
        { "text": "During diaper changes?" },
        { "text": "When you are reading him/her a story?" },
        { "text": "When you are talking to him/her?" }
      ],
      "options": [
        { "label": "Yes" },
        { "label": "No" }
      ],
      "next": "determine_score"
    },
    "determine_score": {
      "type": "transient_logic",
      "conditions": [
        {
          "type": "count_threshold",
          "min": 2,
          "max": 999,
          "actions": [{ "type": "set_score", "value": 0 }],
          "next": "completed"
        },
        {
          "type": "selection_count",
          "expression": "any_selected",
          "actions": [],
          "next": "check_frequency_every_day"
        },
        {
          "type": "selection_count",
          "expression": "none_selected",
          "actions": [{ "type": "set_score", "value": 1 }],
          "next": "completed"
        }
      ]
    },
    "check_frequency_every_day": {
      "type": "followup_question",
      "text": "Does your child look you in the eye every day?",
      "options": [
        { "label": "Yes", "next": "check_frequency_5_times" },
        { "label": "No", "actions": [{ "type": "set_score", "value": 1 }], "next": "completed" }
      ]
    },
    "check_frequency_5_times": {
      "type": "followup_question",
      "text": "On a day when you are together all day, does he/she look you in the eye at least 5 times?",
      "options": [
        { "label": "Yes", "actions": [{ "type": "set_score", "value": 0 }], "next": "completed" },
        { "label": "No", "actions": [{ "type": "set_score", "value": 1 }], "next": "completed" }
      ]
    }
  },
  "metadata": {
    "copyright": "©2009 Diana Robins, Deborah Fein, & Marianne Barton",
    "version": "Terminology Update March 2025"
  }
}
