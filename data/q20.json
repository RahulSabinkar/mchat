{
  "item_number": 20,
  "question": "20. Does ____________ like movement activities?",
  "flow": {
    "start": {
      "type": "initial_question",
      "options": {
        "Yes": { "next": "ask_enjoy_bounced_swung" },
        "No": { "next": "ask_reaction" }
      }
    },
    "ask_enjoy_bounced_swung": {
      "type": "followup_question",
      "text": "Does he/she enjoy being bounced or swung?",
      "options": {
        "Yes": { "result_score": 0 },
        "No": { "next": "ask_reaction" }
      }
    },
    "ask_reaction": {
      "type": "instruction",
      "text": "When you swing or bounce him/her, how does he/she react? (If parent does not give an example below, ask each individually.)",
      "next": "evaluate_behaviors"
    },
    "evaluate_behaviors": {
      "type": "checklist",
      "instruction": "Does your child...",
      "items": [
        "Laugh or smile?",
        "Talk or babble?",
        "Request more by holding out his/her arms?",
        "Other (describe): ________________________________________________"
      ],
      "options": ["Yes", "No"],
      "next": "determine_score"
    },
    "determine_score": {
      "type": "decision_logic",
      "conditions": {
        "any_selected": { "result_score": 0 },
        "none_selected": { "result_score": 1 }
      }
    }
  },
  "metadata": {
    "copyright": "©2009 Diana Robins, Deborah Fein, & Marianne Barton",
    "version": "Terminology Update March 2025"
  }
}
