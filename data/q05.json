{
  "item_number": 5,
  "question": "5. Does _________ make unusual finger movements near his/her eyes?",
  "flow": {
    "start": {
      "type": "initial_question",
      "options": {
        "Yes": { "next": "ask_yes_followup" },
        "No": { "result_score": 0 }
      }
    },
    "ask_yes_followup": {
      "type": "instruction",
      "text": "Please describe these movements (If parent does not give a 0 example below, ask each individually.)",
      "next": "evaluate_behaviors"
    },
    "evaluate_behaviors": {
      "type": "checklist",
      "categories": {
        "pass_examples": {
          "instruction": "Does he/she ...\n(Below are pass examples)",
          "items": ["Look at hands?", "Move fingers when playing peek-a-boo?"]
        },
        "risk_examples": {
          "instruction": "Does he/she...\n(Below are risk examples)",
          "items": [
            "Wiggle his/her fingers near his/her eyes?",
            "Hold his/her hands up close to his/her eyes?",
            "Hold his/her hands off to the side of his/her eyes?",
            "Flap his/her hands near his/her face?",
            "Other (describe) ________________________________________________"
          ]
        }
      },
      "options": ["Yes", "No"],
      "next": "determine_score"
    },
    "determine_score": {
      "type": "decision_logic",
      "conditions": {
        "only_pass_selected": { "result_score": 0 },
        "none_selected": { "result_score": 0 },
        "only_risk_selected": { "next": "check_frequency" },
        "both_selected": { "next": "check_frequency" }
      }
    },
    "check_frequency": {
      "type": "followup_question",
      "text": "Does this happen more than twice a week?",
      "options": {
        "No": { "result_score": 0 },
        "Yes": { "result_score": 1 }
      }
    }
  },
  "metadata": {
    "copyright": "©2009 Diana Robins, Deborah Fein, & Marianne Barton",
    "version": "Terminology Update March 2025"
  }
}
