{
  "item_number": 4,
  "question": "4. Does _________ like climbing on things?",
  "flow": {
    "start": {
      "type": "initial_question",
      "options": [
        { "label": "Yes", "next": "ask_yes_followup" },
        { "label": "No", "next": "evaluate_behaviors" }
      ]
    },
    "ask_yes_followup": {
      "type": "instruction",
      "text": "Please give me an example of something he/she enjoys climbing on. (If parent does not give a 0 example below, ask each individually.)",
      "next": "evaluate_behaviors"
    },
    "evaluate_behaviors": {
      "type": "checklist",
      "instruction": "Does he/she enjoy climbing on...",
      "items": [
        { "text": "Stairs?" },
        { "text": "Chairs?" },
        { "text": "Furniture?" },
        { "text": "Playground equipment?" }
      ],
      "options": [
        { "label": "Yes" },
        { "label": "No" }
      ],
      "next": "determine_score"
    },
    "determine_score": {
      "type": "transient_logic",
      "conditions": [
        {
          "type": "selection_count",
          "expression": "any_selected",
          "actions": [{ "type": "set_score", "value": 0 }],
          "next": "completed"
        },
        {
          "type": "selection_count",
          "expression": "none_selected",
          "actions": [{ "type": "set_score", "value": 1 }],
          "next": "completed"
        }
      ]
    }
  },
  "metadata": {
    "copyright": "©2009 Diana Robins, Deborah Fein, & Marianne Barton",
    "version": "Terminology Update March 2025"
  }
}
