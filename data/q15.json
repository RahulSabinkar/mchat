{
  "item_number": 15,
  "question": "15. Does ____________ try to copy what you do?",
  "flow": {
    "start": {
      "type": "initial_question",
      "options": [
        { "label": "Yes", "next": "ask_yes_followup" },
        { "label": "No", "next": "evaluate_behaviors" }
      ]
    },
    "ask_yes_followup": {
      "type": "instruction",
      "text": "Please give me an example of something he/she would try to copy. (If parent does not give one of the following 0 examples, ask each individually.)",
      "next": "evaluate_behaviors"
    },
    "evaluate_behaviors": {
      "type": "checklist",
      "instruction": "Does your child try to copy you if you...",
      "items": [
        { "text": "Stick out your tongue?" },
        { "text": "Make a funny sound?" },
        { "text": "Wave good bye?" },
        { "text": "Clap your hands?" },
        { "text": "Put your fingers to your lips to signal \"Shhh\"?" },
        { "text": "Blow a kiss?" },
        { "text": "Other (describe): ________________________________________________" }
      ],
      "options": [
        { "label": "Yes" },
        { "label": "No" }
      ],
      "next": "determine_score"
    },
    "determine_score": {
      "type": "transient_logic",
      "conditions": [
        {
          "type": "count_threshold",
          "min": 2,
          "max": 999,
          "actions": [{ "type": "set_score", "value": 0 }],
          "next": "completed"
        },
        {
          "type": "selection_count",
          "expression": "any_selected",
          "actions": [{ "type": "set_score", "value": 1 }],
          "next": "completed"
        },
        {
          "type": "selection_count",
          "expression": "none_selected",
          "actions": [{ "type": "set_score", "value": 1 }],
          "next": "completed"
        }
      ]
    }
  },
  "metadata": {
    "copyright": "©2009 Diana Robins, Deborah Fein, & Marianne Barton",
    "version": "Terminology Update March 2025"
  }
}
