{
  "item_number": 16,
  "question": "16. If you turn your head to look at something, does ____________ look around to see what you are looking at?",
  "flow": {
    "start": {
      "type": "initial_question",
      "options": {
        "Yes": {
          "result_score": 0
        },
        "No": "ask_no_followup"
      }
    },
    "ask_no_followup": {
      "type": "instruction",
      "text": "What does he/she do when you turn to look at something? (If parent does not give a 0 example below, ask each individually.)",
      "next": "evaluate_behaviors"
    },
    "evaluate_behaviors": {
      "type": "checklist",
      "categories": {
        "0_responses": {
          "instruction": "Does your child...\n(Below are 0 responses)",
          "items": [
            "Look toward the thing you are looking at?",
            "Point toward the thing you are looking at?",
            "Look around to see what you are looking at?"
          ]
        },
        "1_responses": {
          "instruction": "Does you child...\n(Below are 1 responses)",
          "items": ["Ignore you?", "Look at your face?"]
        }
      },
      "options": ["Yes", "No"],
      "next": "determine_score"
    },
    "determine_score": {
      "type": "decision_logic",
      "conditions": {
        "Yes only to 0 example(s)": {
          "result_score": 0
        },
        "Yes only to 1 example(s)": {
          "result_score": 1
        },
        "Yes to both 0 and 1 examples": {
          "next": "clarify_frequency"
        }
      }
    },
    "clarify_frequency": {
      "type": "followup_question",
      "text": "Which one does he/she do most often?",
      "options": {
        "0 response": {
          "result_score": 0
        },
        "1 response": {
          "result_score": 1
        }
      }
    }
  },
