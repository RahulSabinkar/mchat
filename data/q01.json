{
  "item_number": 1,
  "question": "1. If you point at something across the room, does ____________ look at it?",
  "flow": {
    "start": {
      "type": "initial_question",
      "options": [
        { "label": "Yes", "next": "ask_yes_followup" },
        { "label": "No", "next": "ask_no_followup" }
      ]
    },
    "ask_yes_followup": {
      "type": "instruction",
      "text": "Please give me an example of how he/she will respond if you point at something (If parent does not give a 0 example below, ask each individually.)",
      "next": "evaluate_behaviors"
    },
    "ask_no_followup": {
      "type": "instruction",
      "text": "If you point at something, what does your child typically do?",
      "next": "evaluate_behaviors"
    },
    "evaluate_behaviors": {
      "type": "checklist",
      "instruction": "Does he/she ...",
      "categories": [
        {
          "id": "pass_examples",
          "label": "0 examples",
          "items": [
            { "text": "Look at object?" },
            { "text": "Point to object?" },
            { "text": "Look and comment on object?" },
            { "text": "Look if you point and say \"look!\"?" }
          ]
        },
        {
          "id": "risk_examples",
          "label": "1 examples",
          "items": [
            { "text": "Ignores you?" },
            { "text": "Look around room randomly?" },
            { "text": "Look at your finger?" }
          ]
        }
      ],
      "options": [{ "label": "Yes" }, { "label": "No" }],
      "next": "determine_score"
    },
    "determine_score": {
      "type": "transient_logic",
      "conditions": [
        {
          "type": "category_selection",
          "expression": "only_pass_selected",
          "actions": [{ "type": "set_score", "value": 0 }],
          "next": "completed"
        },
        {
          "type": "category_selection",
          "expression": "only_risk_selected",
          "actions": [{ "type": "set_score", "value": 1 }],
          "next": "completed"
        },
        {
          "type": "category_selection",
          "expression": "both_selected",
          "actions": [],
          "next": "clarify_frequency"
        },
        {
          "type": "fallback",
          "expression": "none_selected",
          "actions": [
            {
              "type": "require_user_input",
              "message": "Please select at least one 'Yes' behavior, or verify all behaviors are 'No'."
            }
          ],
          "next": "evaluate_behaviors"
        }
      ]
    },
    "clarify_frequency": {
      "type": "followup_question",
      "text": "Which one does he/she do most often?",
      "options": [
        {
          "label": "Most often is pass example",
          "actions": [{ "type": "set_score", "value": 0 }],
          "next": "completed"
        },
        {
          "label": "Most often is risk example",
          "actions": [{ "type": "set_score", "value": 1 }],
          "next": "completed"
        }
      ]
    }
  },
  "metadata": {
    "copyright": "©2009 Diana Robins, Deborah Fein, & Marianne Barton",
    "version": "Terminology Update March 2025"
  }
}
