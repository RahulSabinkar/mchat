{
  "item_number": 1,
  "question": "1. If you point at something across the room, does ____________ look at it?",
  "flow": {
    "start": {
      "type": "initial_question",
      "options": {
        "Yes": { "next": "ask_yes_followup" },
        "No": { "next": "ask_no_followup" }
      }
    },
    "ask_yes_followup": {
      "type": "instruction",
      "text": "Please give me an example of how he/she will respond if you point at something (If parent does not give a 0 example below, ask each individually.)",
      "next": "evaluate_behaviors"
    },
    "ask_no_followup": {
      "type": "instruction",
      "text": "If you point at something, what does your child typically do?",
      "next": "evaluate_behaviors"
    },
    "evaluate_behaviors": {
      "type": "checklist",
      "instruction": "Does he/she ...",
      "categories": {
        "pass_examples": {
          "items": [
            "Look at object?",
            "Point to object?",
            "Look and comment on object?",
            "Look if you point and say \"look!\"?"
          ]
        },
        "risk_examples": {
          "items": [
            "Ignores you?",
            "Look around room randomly?",
            "Look at your finger?"
          ]
        }
      },
      "options": ["Yes", "No"],
      "next": "determine_score"
    },
    "determine_score": {
      "type": "decision_logic",
      "conditions": {
        "only_pass_selected": { "result_score": 0 },
        "only_risk_selected": { "result_score": 1 },
        "both_selected": { "next": "clarify_frequency" }
      }
    },
    "clarify_frequency": {
      "type": "followup_question",
      "text": "Which one does he/she do most often?",
      "options": {
        "Most often is pass example": { "result_score": 0 },
        "Most often is risk example": { "result_score": 1 }
      }
    }
  },
  "metadata": {
    "copyright": "©2009 Diana Robins, Deborah Fein, & Marianne Barton",
    "version": "Terminology Update March 2025"
  }
}
